# Copy this file to .env at the repository root. Do not commit .env.
RPC_URL=https://your-sepolia-rpc.example/v2/your-api-key
PRIVATE_KEY=0xyour_private_key
CONTRACT_ADDRESS=0xyour_deployed_contract_address
CHAIN_ID=11155111
PORT=3001
MAX_FILE_SIZE_BYTES=52428800

# Metadata persistence: use memory only for local development. Production must use firestore.
METADATA_STORAGE=memory
# For Firestore, set METADATA_STORAGE=firestore and configure one credential path below.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----\\n"
# Alternatively use Application Default Credentials outside this file:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
